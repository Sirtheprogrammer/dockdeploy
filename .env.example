# Copy to .env and fill in. Generate each secret with:
#   openssl rand -base64 32

# Seals every stored credential (SSH keys, sudo/registry passwords, deploy env).
# Losing or changing this makes existing credentials permanently unreadable.
APP_ENCRYPTION_KEY=

# Signs session cookies. Rotating it logs everyone out.
SESSION_SECRET=

# Database configuration:
# PostgreSQL is optional! If DATABASE_URL is unset, dockdeploy defaults to
# embedded SQLite (stored at dockdeploy.db or SQLITE_PATH).
#
# When running with Docker Compose, SQLite is stored in the dockdeploy-data volume.
# SQLITE_PATH=/home/app/data/dockdeploy.db
#
# To use external PostgreSQL instead:
# DATABASE_URL=postgres://user:password@host:5432/dockdeploy?sslmode=disable

# Public URL of this dashboard. Used for webhook and invitation links.
APP_URL=http://localhost:8081
PORT=8081

# Bind to 127.0.0.1 by default; put a reverse proxy with TLS in front before
# exposing this to the internet.
BIND_ADDR=127.0.0.1
HOST_PORT=8081

APP_ENV=production
LOG_LEVEL=info
